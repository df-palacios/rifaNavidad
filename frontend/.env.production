# Produccion (VPS): el frontend se sirve en https://dfpalacios.cloud/proyectos/rifa
# y Nginx hace proxy de la API:
#
#   location ^~ /proyectos/rifa/api/ { proxy_pass http://127.0.0.1:8000/api/; }
#
# El codigo construye las rutas como `${API_BASE_URL}/api/<recurso>`, asi que
# aqui va la RAIZ del proyecto (sin /api), para que resulte:
#
#   /proyectos/rifa  +  /api/premios  =  /proyectos/rifa/api/premios
#
# que Nginx traduce a http://127.0.0.1:8000/api/premios
REACT_APP_API_URL=/proyectos/rifa
